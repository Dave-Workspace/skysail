<section class="immigration-funds-section">
<!--<h2 class="special-service-boxes-title">Requirement for Super visa</h2>-->
<div class="services-header text-center">
<div class="col-12 mb-3 d-flex justify-content-center">
<img alt="Can" class="img-fluid can-title-img" src="Images/Can.png"/>
</div>
<h2 class="mb-2 gradient-text" id="travel-ins-anim">Travel Insurance </h2>
<h3 class="mb-3">Guidance</h3>
</div>
<div class="container flex-container">
<!-- Right Column -->
<div class="funds-form section-box">
<!--<h2 style="text-align:center;">Health Insurance Enquiry</h2>-->
<button class="accordion-header" type="button">
<i class="bi bi-shield-check"></i>
    Travel Insurance Enquiry
    <i class="arrow"></i>
</button>
<p class="description">
        Get personalized guidance on the minimum travel insurance coverage you need for Visitor visa in Canada.
      </p>
<form class="needs-validation" id="VVIForm" novalidate="">
<div class="row g-3">
<!-- Name -->
<div class="col-md-6">
<label class="form-label" for="name">Name <span class="required">*</span></label>
<input class="form-control" id="name" placeholder="Full Name" required="" type="text"/>
<div class="invalid-feedback">Please enter your name.</div>
</div>
<!-- Age -->
<div class="col-md-6">
<label class="form-label" for="age">Age <span class="required">*</span></label>
<input class="form-control" id="age" max="120" min="1" placeholder="Your Age" required="" type="number"/>
<div class="invalid-feedback">Please enter a valid age (1-120).</div>
</div>
<!-- Contact -->
<div class="col-md-6">
<label class="form-label" for="contact">Contact <span class="required">*</span></label><br/>
<input class="form-control" id="contact" name="contact" placeholder="" required="" type="tel"/>
<!--<input type="tel" class="form-control" id="contact" placeholder="Phone Number" pattern="^\+?\d{7,15}$" required>-->
<div class="invalid-feedback">Please enter a valid contact number (7-15 digits).</div>
</div>
<!-- Email -->
<div class="col-md-6">
<label class="form-label" for="email">Email <span class="required">*</span></label>
<input class="form-control" id="email" placeholder="Email Address" required="" type="email"/>
<div class="invalid-feedback">Please enter a valid email address.</div>
</div>
<!-- Notes / Description -->
<div class="col-12">
<label class="form-label" for="notes">Notes / Description</label>
<textarea class="form-control" id="notes" maxlength="500" placeholder="Your Message" rows="5"></textarea>
<div class="form-text">Maximum 500 characters.</div>
</div>
<!-- Submit -->
<div class="col-12 center-button">
<button class="fancy_button px-4 py-2 fancy" type="submit">
        SUBMIT FORM
      </button>
</div>
</div>
</form>
</div>
</div>
</section>
<!-- New Section: Canboard Steps with alternating layout -->
<section class="canboard-steps">
<div class="container">
<div class="canboard-steps-header">
<div class="col-12 mb-3 d-flex justify-content-center">
<img alt="How" class="img-fluid how-title-img" src="Images/How.png"/>
</div>
<div aria-hidden="true" class="rcic-underline mx-auto"></div>
</div>
<!-- Step 1: Register -->
<div class="row align-items-center mb-5">
<!-- Text column - always first on mobile -->
<div class="col-md-6">
<div class="step-content-wrapper">
<div class="step-bar step-bar-1"></div>
<div class="step-label">REGISTER</div>
<h3 class="step-title">Sign Up for Free</h3>
<div class="step-content">
<p>Create your account, share your Career Goals, and get personalized recommendations all in just a few minutes!</p>
</div>
</div>
</div>
<!-- Image column - always second on mobile -->
<div class="col-md-6">
<div class="step-img-container">
<img alt="Create your account" class="step-img img-fluid" src="Images/Sign_Up.png"/>
</div>
</div>
</div>
</div>
</section>
<!-- Sticky Progress Steps Section - Aspiria Style -->
<section class="aspiria-progress-section">
<!-- Sticky Progress Bar - Outside container for proper sticky behavior -->
<div class="progress-bar-sticky">
<div class="container">
<div class="progress-bar-container">
<div class="progress-bar-track">
<div class="progress-bar-fill aspiria-progress-fill" id="aspiriaProgressFill"></div>
</div>
</div>
</div>
</div>
<div class="container">
<!-- Step Cards Container -->
<div class="aspiria-cards-container position-relative">
<!-- Step 1: Search -->
<div class="aspiria-card-wrapper aspiria-card-1">
<div class="aspiria-card-content">
<div class="row align-items-center">
<div class="col-md-6 order-md-2">
<div class="step-content-wrapper">
<div class="step-bar step-bar-2"></div>
<div class="step-label">SEARCH</div>
<h3 class="step-title">Select a Visit Service</h3>
<div class="step-content">
<p>
                                            Easily search and explore programs worldwide that match your interests and career goals all
                                            in one place.
                                        </p>
</div>
</div>
</div>
<div class="col-md-6 order-md-1">
<div class="step-img-container">
<img alt="Search for study programs" class="step-img img-fluid" src="Images/Search_Visit.png"/>
</div>
</div>
</div>
</div>
</div>
<!-- Step 2: Apply -->
<div class="aspiria-card-wrapper aspiria-card-2">
<div class="aspiria-card-content">
<div class="row align-items-center">
<div class="col-md-6">
<div class="step-content-wrapper">
<div class="step-bar step-bar-3"></div>
<div class="step-label">APPLY</div>
<h3 class="step-title">Submit Your Application</h3>
<div class="step-content">
<p>
                                            Create your account, share your study goals, and get personalized recommendations all in
                                            just a few minutes!
                                        </p>
</div>
</div>
</div>
<div class="col-md-6">
<div class="step-img-container">
<img alt="Submit application" class="step-img img-fluid" src="Images/Submit.png"/>
</div>
</div>
</div>
</div>
</div>
<!-- Step 3: Approval -->
<div class="aspiria-card-wrapper aspiria-card-3">
<div class="aspiria-card-content">
<div class="row align-items-center">
<div class="col-md-6 order-md-2">
<div class="step-content-wrapper">
<div class="step-bar step-bar-4"></div>
<div class="step-label">APPROVAL</div>
<h3 class="step-title">Submit Your File Through R.C.I.C.</h3>
<div class="step-content">
<p>
                                            Get your application reviewed and submitted with professional support from a Regulated Canadian Immigration Consultant.
                                        </p>
</div>
</div>
</div>
<div class="col-md-6 order-md-1">
<div class="step-img-container">
<img alt="Visa approval" class="step-img img-fluid" src="Images/Visa.png"/>
</div>
</div>
</div>
</div>
</div>
</div>
